# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env ist gitignored und darf NIEMALS committet werden (CLAUDE.md §13).

# /exec-URL der Apps-Script-Web-App
VITE_API_URL=https://script.google.com/macros/s/DEINE_DEPLOYMENT_ID/exec

# Shared Secret (muss mit API_TOKEN im Apps Script übereinstimmen)
VITE_API_TOKEN=DEIN_GEHEIMES_TOKEN
